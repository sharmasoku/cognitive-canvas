SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
SUPABASE_URL="https://your_project.supabase.co"

VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_URL="https://your_project.supabase.co"

# Service-role key (server-only)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Transactional email (Resend)
RESEND_API_KEY="your_resend_api_key"
EMAIL_FROM="TeleARGlass <onboarding@resend.dev>"
RECRUITMENT_NOTIFY_TO=""
PUBLIC_ASSET_BASE_URL="https://your_project.supabase.co/storage/v1/object/public/tele-ar-glass-logo/logo.png"

# PayU Credentials
# Do NOT wrap values in quotes — the runtime reads them literally
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_salt
PAYU_ENV=test
